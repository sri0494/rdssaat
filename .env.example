# ── SERVER ────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── PostgreSQL ────────────────────────────────────────
# Render: auto-injected
# Neon:   paste from neon.tech dashboard
DATABASE_URL=postgresql://user:password@host:5432/rdssaat_db

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=rdssaat_super_secret_key_min_32_chars_change_this
JWT_EXPIRES_IN=8h

# ── PASSWORD RESET (email link — OTP removed from this flow) ─
# Password recovery uses a secure single-use emailed link, not OTP.
# If SMTP_HOST is not set, the reset link is logged to the server console
# instead of emailed — fine for local testing, NOT for production. Set real
# SMTP credentials below to actually deliver reset emails.
PASSWORD_RESET_EXPIRY_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RD-SSAAT <no-reply@yourdomain.com>
# Used to build the link in the reset email (https://your-domain.com/reset-password?token=...).
# Falls back to the request's own host if unset — but set this explicitly in production.
APP_URL=https://rdssaat.onrender.com

# ── OTP (legacy — kept for anything else that might use it; no longer
# used for password reset, see auth.js) ───────────────────────
OTP_EXPIRY_MINUTES=5
OTP_DEBUG_MODE=false

# ── DEFAULT ADMIN ─────────────────────────────────────
ADMIN_ID=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrator
ADMIN_MOBILE=9999999999

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=https://rdssaat.onrender.com
